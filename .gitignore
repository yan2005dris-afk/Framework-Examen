.pnpm-store/
.vite/
.codegraph
# Lockfiles de otros gestores. Este proyecto usa pnpm, asi que pnpm-lock.yaml
# SI se versiona (reproducibilidad de instalaciones).
package-lock.json
yarn.lock
bun.lockb
bun.lock

# Builds y cobertura
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Go
apps/backend/bin/
*.exe

# Secretos y credenciales — nunca versionar (solo .env.example)
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Documentos y adjuntos. Los postulantes suben titulos, certificados y
# documentos de identidad: contienen datos personales y no van al repositorio.
apps/backend/data/
/data/uploads/
/uploads/
/storage/
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Mockup original en React (raiz): ya no esta en el repo, fue reemplazado por
# el set versionado de docs/mockups/. La regla se conserva como red de seguridad
# para que una copia local nunca se versione por accidente.
# El ancla ^ mantiene docs/mockups/ versionable.
/mockups/

