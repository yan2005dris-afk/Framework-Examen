# Entorno de la API. Copiar a .env y ajustar; nunca versionar el .env real.

# Entorno: development | production
APP_ENV=development
PORT=8080
APP_VERSION=dev

# URL pública del frontend (para enlaces de confirmación y correo)
APP_URL=http://localhost:5173

# Cadena de conexión a PostgreSQL. En desarrollo la base local no pide
# contraseña; en producción se define aquí y se inyecta al contenedor.
DATABASE_URL=postgres://postgres@localhost:5432/biess?sslmode=disable

# URL de Redis. Si no se define, la API arranca sin caché ni rate limiting.
REDIS_URL=redis://localhost:6379/0

# Si es true, la API no arranca sin conexión a la base de datos
DB_REQUIRED=false

# Almacenamiento S3 local en RustFS. Crear el bucket biess en la consola :9001.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000/biess
S3_PUBLIC_ENDPOINT=http://localhost:9000/biess
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_SESSION_TOKEN=

# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Vigencia de la sesión de usuario
SESSION_TTL=24h

# Tiempos del servidor HTTP
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=30s

# Tamaño máximo del cuerpo de una petición (10 MiB)
MAX_REQUEST_BODY_BYTES=10485760

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Servidor SMTP. En desarrollo apunta a Mailpit (puerto 1025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@biess.local
# STARTTLS: ponlo en true cuando el servidor SMTP lo requiera.
SMTP_TLS=false

# Clave estable de 32 bytes en base64 para cifrar la cola. Generar fuera del repositorio.
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MAIL_OUTBOX_KEY=

# T16: reenvíos OTP; se mantienen tres fallos y diez minutos de bloqueo.
OTP_RESEND_DELAY=1m
OTP_MAX_SENDS=3
# T17: archivo JSON controlado por UUID de cuenta; vacío = proveedor no disponible.
# En Docker, montar explícitamente el archivo y usar su ruta dentro del contenedor.
ELIGIBILITY_SIMULATION_FILE=
