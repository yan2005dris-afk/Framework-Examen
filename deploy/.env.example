# Variables del despliegue de producción. Copiar a deploy/.env y completar.
# deploy/.env nunca se versiona.

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=biess
# Si la base es administrada fuera de Docker, apuntar aquí y quitar el
# servicio postgres del compose.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/biess?sslmode=disable

# Origen público del portal (el que usa el navegador)
CORS_ALLOWED_ORIGINS=https://concurso.biess.gob.ec

# Límite del cuerpo de las peticiones (10 MiB)
MAX_REQUEST_BODY_BYTES=10485760

# Nivel de log
LOG_LEVEL=info

# Servidor SMTP de correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@biess.local
SMTP_TLS=true
