# Variables del despliegue de producción. Copiar a deploy/.env y completar.
# deploy/.env nunca se versiona.

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=biess
# Si la base es administrada fuera de Docker, apuntar aquí y quitar el
# servicio postgres del compose.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/biess?sslmode=disable

# Origen público del portal (el que usa el navegador)
CORS_ALLOWED_ORIGINS=https://concurso.biess.gob.ec

# Límite del cuerpo de las peticiones (10 MiB)
MAX_REQUEST_BODY_BYTES=10485760

# Nivel de log
LOG_LEVEL=info

# RustFS local. Crear el bucket biess en la consola http://localhost:9001.
# Compose usa http://rustfs:9000/biess para las llamadas internas de la API.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000/biess
S3_PUBLIC_ENDPOINT=http://localhost:9000/biess
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_SESSION_TOKEN=

# Servidor SMTP de correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@biess.local
SMTP_TLS=true

# Clave estable de 32 bytes en base64 para cifrar la cola. Generar fuera del repositorio.
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MAIL_OUTBOX_KEY=

# T16: reenvíos OTP; se mantienen tres fallos y diez minutos de bloqueo.
OTP_RESEND_DELAY=1m
OTP_MAX_SENDS=3
# T17: archivo JSON controlado por UUID de cuenta; vacío = proveedor no disponible.
# En Docker, montar explícitamente el archivo y usar su ruta dentro del contenedor.
ELIGIBILITY_SIMULATION_FILE=
